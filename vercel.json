{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.saswatasg.com" }],
      "destination": "https://saswatasg.com/$1",
      "permanent": true
    },
    {
      "source": "/resume.pdf",
      "destination": "/assets/resume.pdf",
      "permanent": true
    }
  ]
}

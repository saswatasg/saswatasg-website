# Razorpay Standard Checkout credentials
# These are never committed to git (see .gitignore)
# Create a local .env file with your own test credentials

# Vite prefix for frontend - public key only
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# Backend-only secret - must never reach frontend
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
